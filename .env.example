# =============================================================================
# DropLink — Environment Configuration (.env.example)
# Developed by MSR_Coder (https://msr-coder.pages.dev)
# =============================================================================

# Server Port & Runtime Mode
PORT=3000
NODE_ENV=production

# Application Identity & Session Signing Secret (REQUIRED in production)
# Generate a strong random secret, e.g.: openssl rand -base64 32
APP_ID=droplink-app
JWT_SECRET=

# Maximum accepted size per file in bytes (Default: 50 MiB = 52428800)
DROPLINK_MAX_FILE_SIZE_BYTES=52428800

# =============================================================================
# Database Configuration
# Options for DROPLINK_DB_DRIVER:
#   - "local" (development only): stores metadata in a local JSON file; not suitable for ephemeral/serverless production
#   - "mysql" (default if DATABASE_URL is provided): uses MySQL / MariaDB / TiDB via Drizzle ORM
# =============================================================================
DROPLINK_DB_DRIVER=local
DROPLINK_LOCAL_DB_PATH=./storage_data/droplink_db.json
DATABASE_URL=

# =============================================================================
# File Storage Configuration
# Options for DROPLINK_STORAGE_DRIVER:
#   - "local" (development only): stores uploaded files on disk; use s3 for Cloudflare R2 in production
#   - "s3": stores uploaded files in AWS S3 / Cloudflare R2 / MinIO (supports physical deletion)
#   - "remote": uses external presigned URL storage API
# =============================================================================
DROPLINK_STORAGE_DRIVER=local
DROPLINK_STORAGE_DIR=./storage_data/files

# S3-Compatible Storage Settings (Required only when DROPLINK_STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Optional OAuth / Account Authentication Settings
OAUTH_PORTAL_URL=
OAUTH_API_URL=
OWNER_OPEN_ID=
